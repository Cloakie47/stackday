# Copy this file to .env and fill it in. NEVER share .env or paste its contents anywhere.
# Use a TEST-ONLY wallet that holds no real money.

# Private key of the test wallet, starting with 0x
PRIVATE_KEY=

# Network addresses (the defaults work)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Free key from https://etherscan.io/apis (used to verify contracts on BaseScan)
ETHERSCAN_API_KEY=

# Optional: wallet that receives the 0.25% SIP fee. Leave out to use the test wallet itself.
# FEE_RECIPIENT=0x...
