# Copy to .env.local for local development. On Vercel, add the same names under
# Project Settings > Environment Variables. NEVER commit real values or paste them in chat.

# --- Account database (Supabase). Optional: without these the app still works, but names,
# --- saved team lists and attendance are switched off.
# Project URL, from Supabase > Project Settings > API
SUPABASE_URL=
# The "service_role" secret key, from the same page. Server only. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random text (40+ characters). Signs the sign-in cookie.
SESSION_SECRET=

# --- Optional. The app reads Base Sepolia through the public address below by default.
# NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# --- LOCAL TESTING ONLY, never set on Vercel. Offers a pretend wallet for this address that only
# --- works against a local simulated chain (anvil --fork-url https://sepolia.base.org --auto-impersonate)
# --- together with NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_DEV_ACCOUNT=0x...
